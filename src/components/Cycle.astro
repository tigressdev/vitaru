---
import type { Dict } from '../content';

// Port of the pitch's TriadCycle (_refs/pitchdeck0): same geometry, timing and interaction.
// Content follows the current model: no percentage confidence, labs observe rather than confirm.
interface Props { t: Dict; demoHref: string }
const { t, demoHref } = Astro.props;
const c = t.cycle;

const CX = 240, CY = 230, R = 158;
const toXY = (deg: number): [number, number] => {
  const rad = (deg * Math.PI) / 180;
  return [+(CX + R * Math.cos(rad)).toFixed(1), +(CY + R * Math.sin(rad)).toFixed(1)];
};
const [DNA_X, DNA_Y] = toXY(-90);
const [SYN_X, SYN_Y] = toXY(30);
const [TGT_X, TGT_Y] = toXY(150);
const nodes: [number, number][] = [[DNA_X, DNA_Y], [SYN_X, SYN_Y], [TGT_X, TGT_Y]];
const arcs = [
  `M ${DNA_X} ${DNA_Y} A ${R} ${R} 0 0 1 ${SYN_X} ${SYN_Y}`,
  `M ${SYN_X} ${SYN_Y} A ${R} ${R} 0 0 1 ${TGT_X} ${TGT_Y}`,
  `M ${TGT_X} ${TGT_Y} A ${R} ${R} 0 0 1 ${DNA_X} ${DNA_Y}`,
];
const colors = ['#2ec98f', '#3f6df6', '#b846ff'];
const dims = ['rgba(46,201,143,0.18)', 'rgba(63,109,246,0.18)', 'rgba(184,70,255,0.18)'];
const labelProps: { anchor: 'middle' | 'start' | 'end'; dy: number; dx: number }[] = [
  { anchor: 'middle', dy: -52, dx: 0 },
  { anchor: 'start', dy: -8, dx: 44 },
  { anchor: 'end', dy: -8, dx: -44 },
];
const icons = [
  { x: DNA_X - 12, y: DNA_Y - 12, html: '<path d="M4 2c4 5 4 17 0 22M20 2c-4 5-4 17 0 22" stroke-width="1.8"/><path d="M5 7h14M4 12h16M5 17h14" stroke-width="1.5"/>' },
  { x: SYN_X - 12, y: SYN_Y - 13, html: '<path d="M6 2h9l5 5v17H6z" stroke-width="1.8" stroke-linejoin="round"/><path d="M15 2v6h5" stroke-width="1.5"/><path d="M9 10h8M9 13h8M9 16h5" stroke-width="1.5"/>' },
  { x: TGT_X - 12, y: TGT_Y - 12, html: '<circle cx="12" cy="12" r="10" stroke-width="1.8"/><circle cx="12" cy="12" r="6" stroke-width="1.5"/><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke-width="1.4"/>' },
];
const stepIcons = [
  '<path d="M7 2c5 4 5 16 0 20M17 2c-5 4-5 16 0 20M7.5 6h9M7 12h10M7.5 18h9"/>',
  '<path d="M5 2h12l4 4v16H5z"/><path d="M17 2v5h4"/><path d="M9 10h8M9 13h6"/><path d="M17 18A3.5 3.5 0 1 1 14 21"/><path d="M17 18v3h-3"/>',
  '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2" fill="currentColor"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
];
---

<div class="cy" data-cycle>
  <header class="cy-head">
    <div class="cy-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="#2ec98f" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3" /><circle cx="5" cy="5" r="2" /><circle cx="19" cy="5" r="2" /><circle cx="5" cy="19" r="2" /><circle cx="19" cy="19" r="2" /><path d="M7 7l3 3M17 7l-3 3M7 17l3-3M17 17l-3-3" /></svg>
      {c.badge}
    </div>
    <h1>{c.title}<span>{c.titleAccent}</span></h1>
    <p>{c.sub}</p>
  </header>

  <div class="cy-tabs" role="group" aria-label={t.a11y.cycleTabs}>
    {c.steps.map((s, i) => (
      <button type="button" data-cy-tab={i} aria-pressed={i === 0 ? 'true' : 'false'} style={`--on:${colors[i]};--on-dim:${dims[i]}`}>{s.label}</button>
    ))}
  </div>

  <div class="cy-main">
    <div class="cy-orbit">
      <svg viewBox="-40 0 560 460" aria-hidden="true">
        <defs>
          <filter id="cy-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur in="SourceGraphic" stdDeviation="8" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
          <filter id="cy-dot" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur in="SourceGraphic" stdDeviation="6" /></filter>
        </defs>
        <circle cx={CX} cy={CY} r={R} fill="none" stroke="rgba(255,255,255,0.08)" stroke-dasharray="3 9" />
        {arcs.map((d) => <path d={d} fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="2" />)}
        {arcs.map((d, i) => <path class="cy-arc" data-cy-arc={i} d={d} pathLength="1" fill="none" stroke={colors[i]} stroke-width="2.5" stroke-linecap="round" />)}
        {nodes.map(([x, y], i) => <circle class="cy-halo" data-cy-halo={i} cx={x} cy={y} r="52" fill={colors[i]} />)}
        {nodes.map(([x, y], i) => <circle class="cy-node" data-cy-node={i} cx={x} cy={y} r="36" style={`--c:${colors[i]};--d:${dims[i]}`} />)}
        {icons.map((ic, i) => <g class="cy-icon" data-cy-icon={i} transform={`translate(${ic.x}, ${ic.y})`} fill="none" stroke-linecap="round" style={`--c:${colors[i]}`} set:html={ic.html} />)}
        {nodes.map(([x, y], i) => (
          <g class="cy-label" data-cy-label={i} style={`--c:${colors[i]}`}>
            <text x={x + labelProps[i].dx} y={y + labelProps[i].dy} text-anchor={labelProps[i].anchor} class="a">{c.steps[i].label}</text>
            <text x={x + labelProps[i].dx} y={y + labelProps[i].dy + 16} text-anchor={labelProps[i].anchor} class="b">{c.nodeSubs[i]}</text>
          </g>
        ))}
        <circle cx={CX} cy={CY} r="30" fill="rgba(46,201,143,0.08)" stroke="rgba(46,201,143,0.25)" stroke-width="1.5" />
        <text x={CX} y={CY - 5} class="cy-hub">vita</text>
        <text x={CX} y={CY + 8} class="cy-hub">codex</text>
        <circle data-cy-dot cx={DNA_X} cy={DNA_Y} r="16" fill="#2ec98f" opacity="0.25" filter="url(#cy-dot)" />
        <circle data-cy-dot cx={DNA_X} cy={DNA_Y} r="7" fill="#2ec98f" filter="url(#cy-glow)" />
        <circle data-cy-dot cx={DNA_X} cy={DNA_Y} r="3.5" fill="#fff" opacity="0.9" />
        <rect x={CX - 22} y={CY + 36} width="44" height="18" rx="9" fill="rgba(46,201,143,0.15)" stroke="rgba(46,201,143,0.3)" />
        <text x={CX} y={CY + 49} class="cy-count" data-cy-count>01 / 03</text>
      </svg>
      <div class="cy-loop">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2ec98f" stroke-width="2" aria-hidden="true"><path d="M1 4v6h6M23 20v-6h-6" /><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 0 1 3.51 15" /></svg>
        {c.loopNote}
      </div>
    </div>

    <div class="cy-data" aria-live="off">
      {c.steps.map((s, i) => (
        <div class="cy-panel" data-cy-panel={i} hidden={i !== 0}>
          <div class="cy-phead">
            <div class="cy-icobox" style={`color:${s.color};background:${s.color}1a;border-color:${s.color}40`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stepIcons[i]} />
            </div>
            <div>
              <div class="cy-stepbadge" style={`color:${s.color}`}>{s.badge}</div>
              <h3>{s.headline}</h3>
            </div>
          </div>
          <div class="cy-rows">
            {s.items.map((it, n) => (
              <div class="cy-row" style={`--i:${n}`}>
                <div class="cy-rowtop">
                  <div>
                    <div class="cy-rlabel">{it.label}</div>
                    <div class="cy-rcluster">{it.cluster}</div>
                  </div>
                  <span class="cy-rvalue" style={`color:${it.color}`}>{it.value}</span>
                </div>
                <div class="cy-bar"><i style={`background:${it.color};--w:${it.pct}%;--i:${n}`}></i></div>
                <div class="cy-note">{it.note}</div>
              </div>
            ))}
          </div>
          <div class="cy-signal">
            <span style={`background:${s.signalColor}`}></span>
            <em>{s.signal}</em>
          </div>
          <p class="cy-scale">{s.scale}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="cy-callout">
    <div>
      <div class="cy-ckick">{c.calloutKicker}</div>
      <h2>{c.calloutTitle}</h2>
      <p>{c.calloutBody}</p>
      <a class="btn" href={demoHref}>{c.cta}</a>
    </div>
    <div class="cy-chips">
      {c.calloutChips.map((ch) => <div><span style={`background:${ch.color}`}></span>{ch.label}</div>)}
    </div>
  </div>
  <p class="cy-datanote">{c.dataNote}</p>
</div>
